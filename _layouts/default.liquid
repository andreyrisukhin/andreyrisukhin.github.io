{% assign creative_page = false %}
{% if page.url contains '/music/' or page.url == '/ditherer/' or page.url == '/kata/' %}
  {% assign creative_page = true %}
{% endif %}
<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
    {% if creative_page %}
      <link rel="stylesheet" href="{{ '/assets/css/creative.css' | relative_url | bust_css_cache }}">
      <script defer src="{{ '/assets/js/creative-paper.js' | relative_url | bust_file_cache }}"></script>
    {% endif %}
  </head>

  <!-- Body -->
  <body class="{% if creative_page %}creative-paper{% endif %} {% if page.url contains '/music/' %}music-notebook{% endif %} {% if site.navbar_fixed %}fixed-top-nav{% endif %} {% if site.footer_fixed %}fixed-bottom-footer{% else %}sticky-bottom-footer{% endif %}">
    {% if creative_page %}
      <div class="creative-wash" aria-hidden="true"><span></span><span></span><span></span></div>
    {% endif %}
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
