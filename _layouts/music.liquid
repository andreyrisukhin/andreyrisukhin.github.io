---
layout: default
---
<div class="music-page{% if page.sheet_practice %} music-page--sheet-practice{% endif %}">
  <nav class="music-section-nav" aria-label="Music">
    <a
      href="{{ '/music/' | relative_url }}"
      {% if page.permalink == '/music/' %}
        aria-current="page"
      {% endif %}
      >Music</a
    >
    {% for section in site.data.music.navigation %}
      {% assign section_routes = section.items | map: 'url' %}
      <a
        href="{{ '/music/#' | append: section.id | relative_url }}"
        {% if section_routes contains page.permalink %}
          aria-current="location"
        {% endif %}
      >
        {{- section.title -}}
      </a>
    {% endfor %}
  </nav>
  <article>
    <header class="music-page-header">
      <p class="music-eyebrow">Andrey Plays Accordion (Bayan)</p>
      <h1>{{ page.title }}</h1>
      {% if page.description %}
        <p class="music-lead">{{ page.description }}</p>
      {% endif %}
    </header>
    {{ content }}
  </article>
</div>
