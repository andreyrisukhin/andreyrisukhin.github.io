---
layout: default
---
<div class="post">
  <header class="post-header">
    {% if page.type == 'categories' %}
      <h1 class="post-title">Posts in “{{ page.title }}”</h1>
    {% elsif page.type == 'year' %}
      <h1 class="post-title">Posts from {{ page.date | date: '%Y' }}</h1>
    {% elsif page.type == 'tags' %}
      <h1 class="post-title">Posts tagged “{{ page.title }}”</h1>
    {% endif %}
    <p class="post-description"><a href="{{ '/blog/' | relative_url }}">All writing</a></p>
  </header>

  <article class="archive">
    <table class="archive-list">
      {% for document in page.documents %}
        <tr>
          <th scope="row" class="archive-list__date">
            <time datetime="{{ document.date | date: '%Y-%m-%d' }}">{{ document.date | date: '%b %-d, %Y' }}</time>
          </th>
          <td class="archive-list__title">
            {% if document.redirect == blank %}
              <a class="post-link" href="{{ document.url | relative_url }}">{{ document.title }}</a>
            {% elsif document.redirect contains '://' %}
              <a class="post-link" href="{{ document.redirect }}" target="_blank">{{ document.title }}</a>
            {% else %}
              <a class="post-link" href="{{ document.redirect | relative_url }}">{{ document.title }}</a>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>
  </article>
</div>
