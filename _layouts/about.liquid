---
layout: default
---
<div class="post homepage-post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  {% assign home_sections = page.home_layout.sections %}
  {% unless home_sections %}
    {% assign home_sections = 'intro,news,latest_posts,selected_papers,social' | split: ',' %}
  {% endunless %}
  {% assign profile_width = page.home_layout.profile_width | default: 30 %}

  <article class="homepage-layout" data-homepage-layout>
    {% for home_section in home_sections %}
      {% case home_section %}
        {% when 'intro' %}
          <section class="homepage-section" data-homepage-section="intro" data-homepage-section-label="intro">
            <div class="homepage-intro">
              <div
                class="homepage-intro__content"
                style="--homepage-intro-content-offset: {{ page.home_layout.intro_content_offset | default: '0px' }};"
              >
                {% if page.home_layout.header_sketch and page.home_layout.header_sketch.enabled %}
                  <div
                    class="homepage-intro__sketch {% if page.home_layout.header_sketch.image %}has-image{% else %}is-placeholder{% endif %}"
                    style="--homepage-sketch-width: {{ page.home_layout.header_sketch.width | default: '11rem' }};"
                  >
                    {% if page.home_layout.header_sketch.image %}
                      {% assign header_sketch_path = page.home_layout.header_sketch.image | prepend: 'assets/img/' %}
                      <img
                        src="{{ header_sketch_path | relative_url }}"
                        alt="{{ page.home_layout.header_sketch.alt | default: 'homepage sketch' }}"
                      >
                    {% else %}
                      <span>sketch</span>
                    {% endif %}
                  </div>
                {% endif %}

                {{ content }}
              </div>

              {% if page.profile %}
                <div
                  class="profile homepage-intro__profile"
                  style="--homepage-profile-width: {{ profile_width }}%;"
                  data-homepage-profile
                >
                  {% if page.profile.image %}
                    {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
                    {% if page.profile.image_circular %}
                      {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
                    {% else %}
                      {% assign profile_image_class = 'img-fluid z-depth-1
                rounded' %}
                    {% endif %}
                    {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
                30vw, 95vw"{% endcapture %}
                    {%
                      include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
                      cache_bust=true
                    %}
                  {% endif %}
                  {% if page.profile.more_info %}
                    <div class="more-info">{{ page.profile.more_info }}</div>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </section>

        {% when 'news' %}
          {% if page.announcements and page.announcements.enabled %}
            <section class="homepage-section" data-homepage-section="news" data-homepage-section-label="news">
              <h2>
                <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
              </h2>
              {% include news.liquid limit=true %}
            </section>
          {% endif %}

        {% when 'latest_posts' %}
          {% if page.latest_posts and page.latest_posts.enabled %}
            <section class="homepage-section" data-homepage-section="latest_posts" data-homepage-section-label="latest posts">
              <h2>
                <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
              </h2>
              {% include latest_posts.liquid %}
            </section>
          {% endif %}

        {% when 'selected_papers' %}
          {% if page.selected_papers %}
            <section
              class="homepage-section"
              data-homepage-section="selected_papers"
              data-homepage-section-label="selected publications"
            >
              <h2>
                <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
              </h2>
              {% include selected_papers.liquid %}
            </section>
          {% endif %}

        {% when 'social' %}
          {% if page.social %}
            <section class="homepage-section" data-homepage-section="social" data-homepage-section-label="social">
              <div class="social">
                <div class="contact-icons">{% include social.liquid %}</div>

                <div class="contact-note">{{ site.contact_note }}</div>
              </div>
            </section>
          {% endif %}
      {% endcase %}
    {% endfor %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
