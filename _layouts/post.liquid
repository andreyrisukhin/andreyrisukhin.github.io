---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% comment %}A category that repeats a tag adds a second link to the same posts.{% endcomment %}
{% assign shown_categories = '' | split: '' %}
{% for category in page.categories %}
  {% unless page.tags contains category %}
    {% assign shown_categories = shown_categories | push: category %}
  {% endunless %}
{% endfor %}
{% assign categories = shown_categories | join: '' %}
{% assign url_beginning = page.url | slice: 0, 6 %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% if jekyll.environment == 'development' %}
  <script src="{{ '/assets/js/post-font-preview.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
{% assign post_style = page.post_style | default: site.post_style | default: 'reading' %}
<div class="post post-reading{% if post_style == 'paper' %} post-reading--paper{% endif %}">
  <header class="post-header">
    {% if page.series %}{% include project-series.liquid mode="header" %}{% endif %}
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      {{- page.date | date: '%B %-d, %Y' -}}
      {%- if page.last_updated %} · updated {{ page.last_updated | date: '%B %-d, %Y' }}{% endif -%}
      {%- if page.author %} · {{ page.author }}{% endif -%}
      {%- if page.meta %} · {{ page.meta }}{% endif -%}
      {%- for tag in page.tags %}
        ·
        {% if url_beginning == '/blog/' -%}
          <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">{{ tag }}</a>
        {%- else -%}
          {{ tag }}
        {%- endif -%}
      {%- endfor -%}
      {%- for category in shown_categories %}
        ·
        {% if url_beginning == '/blog/' -%}
          <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}">{{ category }}</a>
        {%- else -%}
          {{ category }}
        {%- endif -%}
      {%- endfor %}
    </p>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.series %}{% include project-series.liquid mode="footer" %}{% endif %}

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
