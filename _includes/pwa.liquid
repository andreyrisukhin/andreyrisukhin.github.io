{% assign pwa_path = page.permalink | default: page.url %}
{% if pwa_path contains '/music' %}
  <link rel="manifest" href="{{ '/manifest.webmanifest' | relative_url }}">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Bayan">
  <meta name="theme-color" content="#faf7f0" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#201d1a" media="(prefers-color-scheme: dark)">
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="{{ '/assets/img/pwa/apple-touch-icon-180.png' | relative_url }}"
  >
  <script>
    (function () {
      if (!('serviceWorker' in navigator)) return;
      var swUrl = '{{ "/sw.js" | relative_url }}';
      window.addEventListener('load', function () {
        navigator.serviceWorker
          .register(swUrl, { scope: '{{ "/music/" | relative_url }}' })
          .then(function (reg) {
            if (navigator.storage && navigator.storage.persist) {
              navigator.storage.persist().catch(function () {});
            }
            setInterval(
              function () {
                reg.update().catch(function () {});
              },
              60 * 60 * 1000
            );
          })
          .catch(function () {});
        var refreshing = false;
        var hadController = !!navigator.serviceWorker.controller;
        navigator.serviceWorker.addEventListener('controllerchange', function () {
          // First installation does not need a reload, especially during editing.
          if (!hadController) {
            hadController = true;
            return;
          }
          if (refreshing) return;
          refreshing = true;
          window.location.reload();
        });
      });
    })();
  </script>
{% endif %}
