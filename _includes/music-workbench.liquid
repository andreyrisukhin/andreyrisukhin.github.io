<section class="workbench" aria-label="Bayan workbench" data-share-base="{{ '/music/workbench/' | relative_url }}">
  <div class="wb-view-switch" role="group" aria-label="Study view">
    <button type="button" data-view="chord" aria-pressed="true">Chord / notes</button>
    <button type="button" data-view="progression" aria-pressed="false">Progression</button>
  </div>
  <p id="wb-draft-status" class="music-small" role="status">Your current practice is kept in this browser.</p>
  {% include music-composer.liquid %}
  <section class="wb-chooser" aria-labelledby="wb-choose-title">
    <div class="wb-section-heading">
      <h2 id="wb-choose-title">Choose material</h2>
      <div class="wb-source-switch" role="group" aria-label="Selection method">
        <button type="button" data-source="type" aria-pressed="true">Type</button>
        <button type="button" data-source="menu" aria-pressed="false">Chord menu</button>
        <button type="button" data-source="notes" aria-pressed="false">Pick notes</button>
      </div>
    </div>
    <div id="wb-source-type" class="workbench-input-row">
      <label for="workbench-input" id="wb-input-label" class="sr-only">Chord name or notes</label>
      <input
        type="text"
        id="workbench-input"
        class="workbench-input"
        placeholder="Am7 or C E G"
        value="Am7"
        maxlength="500"
        aria-describedby="workbench-input-help"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      >
      <p id="workbench-input-help">Notes are bass first. A bare C is one note; CM is a major chord.</p>
      <div class="workbench-hint">
        <span class="workbench-hint-label">Try</span>
        <button type="button" class="workbench-chip" data-example="Am7">Am7</button>
        <button type="button" class="workbench-chip" data-example="C E G">C E G</button>
        <button type="button" class="workbench-chip" data-example="Fd7/C">Fd7/C</button>
        <button type="button" class="workbench-chip" data-example="2 5 1 in G" data-progression-only hidden>ii–V–I in G</button>
      </div>
    </div>
    <div id="wb-source-menu" hidden>
      <div class="wb-menu-fields">
        <label
          >Root
          <select id="wb-menu-root"></select
        ></label>
        <label
          >Chord type
          <select id="wb-menu-quality"></select
        ></label>
        <button type="button" data-action="choose-menu" class="music-share-btn">Choose chord</button>
      </div>
      <details class="workbench-disclosure">
        <summary>Browse every chord type</summary>
        <div id="workbench-matrix" class="workbench-matrix"></div>
      </details>
    </div>
    <div id="wb-source-notes" hidden>
      <p class="music-small">Select pitch classes, bass first. Choose a selected note again to remove it.</p>
      <div id="wb-note-picker" class="workbench-hint" role="group" aria-label="Pick notes"></div>
      <button type="button" data-action="clear-notes" class="music-share-btn">Clear notes</button>
    </div>
    <div id="wb-selection-feedback" class="wb-selection-feedback" role="status" aria-live="polite"></div>
    <div id="wb-candidate-actions" class="wb-play-actions" hidden>
      <button type="button" data-action="append" class="wb-primary">Add to progression</button>
      <button type="button" data-action="replace" class="music-share-btn">Replace selected chord</button>
    </div>
    <label id="wb-chord-transpose" class="music-small"
      >Transpose selection
      <select id="wb-transpose-root"></select
    ></label>
  </section>
  <details id="wb-progression-library" class="workbench-disclosure" hidden>
    <summary>Load a progression or exercise</summary>
    <p class="music-small">Loading replaces the current sequence. Save it first if you want to keep it.</p>
    <div id="workbench-library" class="workbench-hint"></div>
  </details>
  <p id="workbench-announcement" class="sr-only" role="status" aria-live="polite"></p>
  <section id="wb-progression-view" aria-label="Progression study" hidden>
    <div id="wb-sequence"></div>
    <div id="workbench-transport" class="wb-transport">
      <div class="wb-play-actions">
        <button type="button" id="workbench-play" class="wb-primary">Play progression</button>
        <label for="workbench-bpm">Tempo <input type="number" id="workbench-bpm" value="96" min="40" max="200"> BPM</label>
        <label><input type="checkbox" id="workbench-loop"> Loop</label>
      </div>
    </div>
  </section>
  <div class="workbench-layout">
    <div class="workbench-main">
      <div id="workbench-result" class="workbench-result"></div>
      <details id="workbench-save-options" class="wb-save-options" hidden>
        <summary>Save or share this practice</summary>
        <div class="wb-play-actions">
          <label for="workbench-save-name">Name <input type="text" id="workbench-save-name" placeholder="Optional" maxlength="120"></label>
          <button type="button" id="workbench-save" class="music-share-btn">Save in this browser</button>
          <button type="button" id="workbench-share" class="music-share-btn">Copy link</button>
        </div>
        <div id="workbench-share-result" hidden>
          <label for="workbench-share-url">Shareable link</label>
          <input type="text" id="workbench-share-url" class="music-share-text" readonly>
        </div>
      </details>
      <details class="workbench-disclosure wb-scratchpad">
        <summary>Notation scratchpad</summary>
        <button type="button" data-action="sheet" class="music-share-btn">Open ABC draft</button>
        <p class="music-small">A separate notation draft, not automatic harmonization. Link imports are not supported.</p>
      </details>
      <div id="workbench-sheet" class="workbench-sheet" hidden></div>
    </div>
    <aside id="workbench-setlist" class="workbench-setlist" aria-label="Saved practice" style="display: none"></aside>
  </div>
</section>
<noscript>
  <p>The workbench needs JavaScript. For Am7, play A bass with the C major chord button: A + C E G.</p>
  <p>
    The <a href="{{ '/music/scales/' | relative_url }}">scale reference</a> and
    <a href="{{ '/music/intervals/' | relative_url }}">interval reference</a> work without JavaScript.
  </p>
</noscript>
<script>
  window.MusicExercises = {{ site.data.music.exercises.exercises | jsonify }};
  window.StradellaButtons = {
    {% for btn in site.data.music.stradella_buttons.buttons %}
    {{ btn.id | jsonify }}: {{ btn.offsets | jsonify }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };
</script>
