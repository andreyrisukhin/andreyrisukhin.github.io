{% assign sheet_slug = include.slug %}
{% assign sheet_dir = include.asset_dir | default: sheet_slug %}
{% assign musicxml_path = '/assets/music/sheet-music/' | append: sheet_dir | append: '/' | append: sheet_slug | append: '.musicxml' %}
{% assign source_ext = include.source_ext | default: 'mscz' %}
{% assign source_path = '/assets/music/sheet-music/' | append: sheet_dir | append: '/' | append: sheet_slug | append: '.' | append: source_ext %}

<div
  class="sheet-music-page sheet-music-page--flexoki sheet-reader"
  data-playback="{{ include.playback | default: false }}"
  data-score-heading="{% if include.score_heading == false %}false{% else %}true{% endif %}"
  {% if include.local_file %}
    data-local-file="true"
  {% else %}
    data-musicxml-url="{{ musicxml_path | relative_url }}?v={{ site.time | date: '%s' }}"
  {% endif %}
  {% if include.rendered_audio %}
    data-rendered-label="{{ include.rendered_label | default: 'Recording' | escape }}"
    data-rendered-audio-url="{{ include.rendered_audio | relative_url }}"
  {% endif %}
  {% if include.timing_json %}
    data-timing-url="{{ include.timing_json | relative_url }}"
  {% endif %}
  {% if include.playback_instrument %}
    data-playback-instrument="{{ include.playback_instrument }}"
  {% endif %}
  {% if include.playback_gain %}
    data-playback-gain="{{ include.playback_gain }}"
  {% endif %}
  {% if include.playback_stradella %}
    data-playback-stradella="true"
  {% endif %}
  {% if include.key_mode %}
    data-key-mode="{{ include.key_mode }}"
  {% endif %}
>
  {% if include.local_file %}
    <div class="sheet-file-controls">
      <label for="sheet-file">Choose MusicXML</label>
      <input
        id="sheet-file"
        type="file"
        accept=".musicxml,.xml,application/vnd.recordare.musicxml+xml,application/xml,text/xml"
        aria-describedby="sheet-file-help"
      >
      <button id="sheet-file-clear" class="music-share-btn" type="button" disabled hidden>Close score</button>
      <p id="sheet-file-help">Uncompressed .musicxml or .xml, up to 10 MB. Scores are not saved; reopening this page clears them.</p>
      <p id="osmd-status" class="sheet-music-status" role="status">Choose a MusicXML file to begin.</p>
    </div>
    {% include sheet-corrections.liquid %}
  {% endif %}
  <div
    class="sheet-music-controls"
    role="group"
    aria-label="Score display"
    {% if include.local_file %}
      hidden
    {% endif %}
  >
    <div class="sheet-music-zoom" role="group" aria-label="Zoom">
      <button id="osmd-zoom-out" class="music-share-btn sheet-music-zoom__step" type="button" aria-label="Smaller notes">−</button>
      <button id="osmd-zoom-reset" class="music-share-btn sheet-music-zoom__level" type="button" aria-label="Zoom 100%, reset">100%</button>
      <button id="osmd-zoom-in" class="music-share-btn sheet-music-zoom__step" type="button" aria-label="Larger notes">+</button>
    </div>
    <button id="osmd-stradella-toggle" class="music-share-btn" type="button" data-pressed="false" aria-pressed="false">Stradella</button>
    <button id="osmd-focus-toggle" class="music-share-btn" type="button" data-pressed="false" aria-pressed="false">Focus</button>
    {% unless include.playback %}
      <p class="sheet-music-readonly">Read-only score: no playback for this piece.</p>
    {% endunless %}
  </div>
  {% if include.playback %}
    {% include sheet-practice.liquid local_file=include.local_file %}
  {% endif %}
  <div id="osmd-container" class="sheet-music-container" tabindex="0" role="region" aria-label="Sheet music, scroll sideways if needed"></div>
  <p
    class="practice-score-help"
    {% if include.local_file %}
      hidden
    {% endif %}
  >
    Tap a note to inspect it. Keyboard: Tab to the score, then use arrow keys and Enter.
  </p>
  {% unless include.local_file %}
    <p id="osmd-status" class="sheet-music-status" role="status">Loading score…</p>
    <details class="sheet-downloads">
      <summary>Score files and credits</summary>
      {% if include.credits %}
        <p>{{ include.credits }}</p>
      {% endif %}
      {% if include.notes %}
        <p>{{ include.notes }}</p>
      {% endif %}
      <a class="music-share-btn" href="{{ source_path | relative_url }}" download>Download .{{ source_ext }}</a>
      <a class="music-share-btn" href="{{ musicxml_path | relative_url }}" download>Download MusicXML</a>
      <p>
        Source files live under <code>{{ '/assets/music/sheet-music/' | append: sheet_dir | append: '/' }}</code>. Notation rendered with
        <a href="https://opensheetmusicdisplay.org/">OpenSheetMusicDisplay</a>.
      </p>
    </details>
  {% endunless %}
  {% include sheet-inspector.liquid %}

  <noscript>
    <p>
      {% if include.local_file %}
        Enable JavaScript to open and render a file in your browser.
      {% else %}
        This page renders sheet music client-side with JavaScript. Download the MusicXML or `.{{ source_ext }}` above to view it in another
        application.
      {% endif %}
    </p>
  </noscript>
</div>

{% unless include.local_file %}
  <link rel="stylesheet" href="{{ '/assets/js/sheet-music/dev-annotator.css?v=6' | relative_url }}">
{% endunless %}

<script>
  window.StradellaButtons = {
    {% for btn in site.data.music.stradella_buttons.buttons %}
    {{ btn.id | jsonify }}: {{ btn.offsets | jsonify }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };
</script>
