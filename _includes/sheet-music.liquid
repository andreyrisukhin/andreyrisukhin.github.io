{% endunless %}
{% if include.playback %}
  <script src="{{ '/assets/js/sheet-music/practice-timeline.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
  <script src="{{ '/assets/js/sheet-music/practice-player.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
  <script src="{{ '/assets/js/sheet-music/score.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
  <script src="{{ '/assets/js/sheet-music/transport.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
  <script defer src="{{ '/assets/js/sheet-music/playhead.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
  <script defer src="{{ '/assets/js/sheet-music/transpose.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
  <script defer src="{{ '/assets/js/sheet-music/playback.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
{% endif %}
<script src="{{ '/assets/js/vendor/opensheetmusicdisplay.min.js' | relative_url }}"></script>
{% if include.local_file %}
  <script src="{{ '/assets/js/sheet-music/local-file.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
{% endif %}
<script defer src="{{ '/assets/js/sheet-music/page.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
{% if include.local_file %}
  <script src="{{ '/assets/js/sheet-music/correction-model.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
  <script defer src="{{ '/assets/js/sheet-music/corrections.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
{% endif %}
