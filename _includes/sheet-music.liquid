<script src="{{ '/assets/js/music/common.js' | relative_url }}"></script>
<script src="{{ '/assets/js/music/chord-name.js' | relative_url }}"></script>
<script src="{{ '/assets/js/music/stradella-data.js' | relative_url }}"></script>
<script src="{{ '/assets/js/music/stradella-recipe.js' | relative_url }}"></script>
<script src="{{ '/assets/js/tactus/audio.js?v=1' | relative_url }}"></script>
<script src="{{ '/assets/js/sheet-music/osmd-bridge.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
<script src="{{ '/assets/js/vendor/soundfont-player.min.js' | relative_url }}"></script>
<script src="{{ '/assets/js/music/bayan-keyboard.js' | relative_url }}"></script>
<script src="{{ '/assets/js/workbench/model.js' | relative_url }}"></script>
<script src="{{ '/assets/js/workbench/player.js' | relative_url }}"></script>
<script src="{{ '/assets/js/workbench/stradella.js' | relative_url }}"></script>
<script src="{{ '/assets/js/workbench/voicings.js' | relative_url }}"></script>
<script defer src="{{ '/assets/js/sheet-music/practice-inspector.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
<script defer src="{{ '/assets/js/sheet-music/stradella-overlay.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
