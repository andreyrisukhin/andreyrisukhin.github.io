    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% assign social_val = socials.instagram_id | default: site.instagram_id %}
  {% if social_val %}
    {% capture link %}https://instagram.com/{{ social_val }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% assign social_val = socials.facebook_id | default: site.facebook_id %}
  {% if social_val %}
    {% capture link %}https://facebook.com/{{ social_val }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% assign social_val = socials.youtube_id | default: site.youtube_id %}
  {% if social_val %}
    {% capture link %}https://youtube.com/@{{ social_val }}{% endcapture %}
