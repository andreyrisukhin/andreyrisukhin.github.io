  {% endif %}
  {% assign social_val = socials.zotero_username | default: site.zotero_username %}
  {% if social_val %}
    {% capture link %}https://www.zotero.org/{{ social_val }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}

  {% capture jsonld_url %}{{ page.url | prepend: site.baseurl | prepend: site.url | remove_first: 'index.html' }}{% endcapture %}
  {% if page.description %}
    {% assign jsonld_description = page.description | strip_html | normalize_whitespace %}
  {% elsif site.description %}
    {% assign jsonld_description = site.description | strip_html | normalize_whitespace %}
  {% else %}
    {% assign jsonld_description = '' %}
  {% endif %}
  {% if page.title and page.title != 'blank' %}
    {% assign jsonld_headline = page.title %}
  {% elsif site.title != 'blank' %}
    {% assign jsonld_headline = site.title %}
  {% else %}
    {% assign jsonld_headline = author_name %}
  {% endif %}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "{% if is_blog_post %}BlogPosting{% else %}WebSite{% endif %}",
      "name": {{ author_name | jsonify }},
      "headline": {{ jsonld_headline | jsonify }},
      "description": {{ jsonld_description | jsonify }},
      "url": {{ jsonld_url | jsonify }},
      {% if is_blog_post %}
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ jsonld_url | jsonify }}
      },
      {% if page.date %}
      "datePublished": {{ page.date | date_to_xmlschema | jsonify }},
      {% endif %}
      {% if page.last_modified_at %}
      "dateModified": {{ page.last_modified_at | date_to_xmlschema | jsonify }},
      {% endif %}
      {% endif %}
      {% if sameaslinks.size > 0 %}
      "sameAs": {{ sameaslinks | jsonify }},
      {% endif %}
      "author": {
        "@type": "Person",
        "name": {{ author_name | jsonify }}
      }
    }
